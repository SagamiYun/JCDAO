# Deployer Private Key (Required)
# Export from your wallet (e.g., MetaMask, Phantom). Must be a 64-character hex string (with or without 0x).
PRIVATE_KEY=your_private_key_here

# Polygon Amoy 测试网 RPC URL
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygon 主网 RPC URL
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# Contract Verification (Optional but recommended)
# Get an API key from PolygonScan (https://polygonscan.com/myapikey)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Gas Reporter (Optional)
REPORT_GAS=false
